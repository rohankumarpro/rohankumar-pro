---
// The unlock popup: "Unlock links", email, newsletter box, Unlock. Nothing else, by design.
import Icon from "./Icon.astro";
interface Props { keyword: string }
const { keyword } = Astro.props;
---
<div class="veil" id="veil" role="dialog" aria-modal="true" aria-labelledby="pop-h" data-keyword={keyword}>
  <form class="pop" id="pf" novalidate>
    <h4 id="pop-h">Unlock links</h4>
    <input class="in" id="pf-email" type="email" placeholder="you@email.com" aria-label="Your email" autocomplete="email" required>
    <div class="hp" aria-hidden="true" style="position:absolute;left:-9999px"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>
    <label class="chk"><input type="checkbox" id="pf-news"><span class="box"><svg viewBox="0 0 16 16"><path d="M3 8.5l3.2 3L13 4.5"/></svg></span>Subscribe to the newsletter</label>
    <button class="btn lg" id="pf-go" type="submit"><span class="lbl">Unlock<Icon name="arrow" /></span></button>
    <p class="err" id="pf-err" role="alert"></p>
  </form>
</div>
