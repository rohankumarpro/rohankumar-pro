{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "site-window-controls",
  "description": "Lets rohankumar.pro (and only it) move, minimise, maximise and close its own window, save the daily backup to Documents, and show Claude over its Assistant window.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://rohankumar.pro/*",
      "https://www.rohankumar.pro/*"
    ]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-save-backup",
    "allow-claude-show",
    "allow-claude-place",
    "allow-claude-hide",
    "allow-claude-close"
  ]
}
